-- GPU Ready Rack measures. Currency values are in million Toman.
Target Accounts = COUNTROWS ( Targets )
Direct Pipeline Accounts = CALCULATE ( COUNTROWS ( Targets ), Targets[DirectPipelineFlag] = 1 )
P1 Accounts = CALCULATE ( COUNTROWS ( Targets ), Targets[Priority] = "P1" )
Average Account Score = AVERAGE ( Targets[Score] )
Direct Base Racks = CALCULATE ( SUM ( Targets[BaseRacks] ), Targets[DirectPipelineFlag] = 1 )
Base ARR (Mn Toman) = CALCULATE ( MAX ( Revenue_Model[UnweightedBaseARR_MnToman] ), Revenue_Model[Scenario] = "Base" )
Expected Base ARR (Mn Toman) = CALCULATE ( MAX ( Revenue_Model[ExpectedProbabilityWeightedARR_MnToman] ), Revenue_Model[Scenario] = "Base" )
Qualified Canvas Records = CALCULATE ( COUNTROWS ( Customer_Canvas ), Customer_Canvas[Stage] = "Qualified" )
